            fill="#71717A"></path>
          <path
            d="M27.8051 49.9939C27.6788 49.5258 27.5344 49.2917 27.5885 49.1117C28.4547 46.6451 28.581 44.3045 26.2892 42.5041C23.853 40.5596 21.1101 39.9655 18.1505 41.1358C14.3789 42.6121 12.9714 45.6909 12.3217 49.4718C10.9502 57.6097 15.7504 62.4529 21.4349 66.792C23.3477 68.2503 25.6576 69.1865 27.769 70.3748C30.6563 72.0132 33.5437 73.6696 36.6836 75.4701C36.0159 75.9742 35.7633 76.2983 35.4926 76.3163C23.2575 76.7124 12.9172 72.8414 5.69889 62.5609C-0.256246 54.0809 0.862597 42.5221 7.95462 35.9325C13.8195 30.4772 22.4455 29.9731 28.2743 34.7442C31.7752 37.6249 33.2369 42.7561 31.6669 46.5911C30.9451 48.3555 29.8443 49.6698 27.8051 49.9939Z"
            fill="#71717A"></path>
          <path
            d="M55.7942 43.9804C61.9839 34.6002 64.6006 24.8418 58.6454 13.6071C60.0169 14.1652 60.5944 14.2373 60.9373 14.5433C64.7449 18.0542 67.6864 22.1592 69.1842 27.1464C71.3858 34.4922 68.3541 40.5416 61.1538 43.2243C59.656 43.7824 58.068 44.0885 56.5341 44.5026C56.2814 44.3405 56.0468 44.1605 55.7942 43.9804Z"
            fill="#71717A"></path>
          <path
            d="M51.4271 5.14506C54.9641 2.89451 58.5191 2.48041 62.0742 4.89299C63.193 5.64918 63.987 6.65742 63.211 8.07976C62.5975 9.23204 60.8109 9.55612 59.6199 8.31382C57.3461 5.90124 54.5129 5.46913 51.4271 5.14506Z"
            fill="#71717A"></path>
          <path
            d="M2.93786 24.7878C3.40705 26.7683 3.94843 28.7308 4.2913 30.7293C4.52589 32.1516 4.30934 33.664 2.50475 33.844C0.95281 33.988 0.393388 32.6557 0.1227 31.3954C-0.418676 28.7128 0.934765 26.6603 2.16188 24.5718C2.41453 24.6438 2.68521 24.7158 2.93786 24.7878Z"
            fill="#71717A"></path>
        </svg>
        <span class="text-sm text-zinc-400">AI Studio</span>
      </a>
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/vitorwlima/ai-studio"
          class="text-sm text-zinc-400 transition-colors hover:text-zinc-700"
          target="_blank"
        >
          GitHub
        </a>
        <a
          href="https://app.aistudio.gg/"
          class="text-sm text-zinc-400 transition-colors hover:text-zinc-700"
        >
          Open App
        </a>
      </div>
    </div>
  </footer>
</Layout>
